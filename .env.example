# SEC EDGAR — no API key, but the SEC requires a User-Agent with real
# contact info and blocks requests without one. Format: "AppName email"
SEC_USER_AGENT=StockResearch you@example.com

# Firecrawl — get a key at https://www.firecrawl.dev
FIRECRAWL_API_KEY=

# Optional: self-hosted Firecrawl instance
# FIRECRAWL_API_URL=https://api.firecrawl.dev
